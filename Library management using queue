MAX = 5
queue = [""] * MAX
front = -1
rear = -1

def enqueue(customer):
    global front, rear

    if rear == MAX - 1:
        print("Booking Queue is Full")
    else:
        if front == -1:
            front = 0
        rear = rear + 1
        queue[rear] = customer
        print(customer, "joined the booking queue.")

def dequeue():
    global front, rear

    if front == -1 or front > rear:
        print("Booking Queue is Empty")
        front = -1
        rear = -1
    else:
        print(queue[front], "has been served.")
        front = front + 1

        if front > rear:
            front = -1
            rear = -1

def display():
    if front == -1:
        print("No customers waiting in the booking queue.")
    else:
        print("Customers waiting in the booking queue:")
        print("[", end="")
        for i in range(front, rear + 1):
            print(queue[i], end="")
            if i != rear:
                print(", ", end="")
        print("]")

while True:
    print("\n===== TICKET BOOKING COUNTER =====")
    print("1. Add Customer")
    print("2. Customer Served")
    print("3. Display Waiting Queue")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        customer = input("Enter Customer Name: ")
        enqueue(customer)

    elif choice == 2:
        dequeue()

    elif choice == 3:
        display()

    elif choice == 4:
        print("Program Ended")
        break

    else:
        print("Invalid Choice")
